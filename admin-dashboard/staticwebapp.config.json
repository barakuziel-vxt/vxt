{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/*.{css,scss,js,png,gif,ico,jpg,jpeg,svg,woff,woff2,ttf}"]
  },
  "routes": [
    {
      "route": "/api/*",
      "methods": ["GET", "POST", "PUT", "DELETE", "PATCH", "HEAD", "OPTIONS"],
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/*.{css,scss,js,png,gif,ico,jpg,jpeg,svg,woff,woff2,ttf}",
      "headers": {
        "cache-control": "max-age=31536000"
      }
    }
  ],
  "mimeTypes": {
    "woff": "font/woff",
    "woff2": "font/woff2"
  }
}
