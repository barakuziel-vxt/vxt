{
  "routes": [
    {
      "route": "/api/*",
      "methods": ["GET", "POST", "PUT", "DELETE", "PATCH", "HEAD", "OPTIONS"],
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/*.{js,css,svg,png,gif,ico,jpg,jpeg,woff,woff2,ttf,eot}",
      "headers": {
        "cache-control": "max-age=31536000"
      }
    },
    {
      "route": "/*",
      "serve": "/index.html",
      "statusCode": 200
    }
  ],
  "mimeTypes": {
    "woff": "font/woff",
    "woff2": "font/woff2"
  }
}
