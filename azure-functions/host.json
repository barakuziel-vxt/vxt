{
  "version": "2.0",
  "comment": "Note: WEBSITE_RUN_FROM_PACKAGE=1 is configured in Azure Function App settings for optimized deployment",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "maxTelemetryItemsPerSecond": 20
      }
    }
  },
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  },
  "functionTimeout": "00:05:00",
  "pythonWorkerConfig": {
    "enableDebugLogging": false
  }
}
