{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "maxTelemetryItemsPerSecond": 20
      }
    }
  },
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  },
  "functionTimeout": "00:10:00",
  "pythonWorkerConfig": {
    "enableDebugLogging": false,
    "workerTimeout": "30"
  },
  "managedDependency": {
    "enabled": true
  },
  "functionLanguageWorkerConfigs": {
    "python": {
      "workerTimeout": "30"
    }
  }
}
