    borderBottomColor: C.border,
  },
  hamburger: {
    marginRight: 16,
    padding: 4,
  },
  hamburgerText: {
    color: C.textPrimary,
    fontSize: 22,
  },
  headerTitle: {
    color: C.textPrimary,
    fontSize: 18,
    fontWeight: '700',
    flex: 1,
  },
  driverBadge: {
    backgroundColor: C.green + '22',
    borderRadius: 8,
    paddingHorizontal: 8,
    paddingVertical: 3,
    borderWidth: 1,
    borderColor: C.green,
  },
