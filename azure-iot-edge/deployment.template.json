{
  "modulesContent": {
    "$edgeAgent": {
      "properties.desired": {
        "schemaVersion": "1.1",
        "runtime": {
          "type": "docker",
          "settings": {
            "minDockerVersion": "v1.25",
            "loggingOptions": "",
            "registryCredentials": {
              "ghcr": {
                "address": "ghcr.io",
                "username": "$GHCR_USERNAME",
                "password": "$GHCR_TOKEN"
              }
            }
          }
        },
        "systemModules": {
          "edgeAgent": {
            "type": "docker",
            "settings": {
              "image": "mcr.microsoft.com/azureiotedge-agent:1.5",
              "createOptions": "{}"
            }
          },
          "edgeHub": {
            "type": "docker",
            "status": "running",
            "restartPolicy": "always",
            "settings": {
              "image": "mcr.microsoft.com/azureiotedge-hub:1.5",
              "createOptions": "{\"HostConfig\":{\"PortBindings\":{\"5671/tcp\":[{\"HostPort\":\"5671\"}],\"8883/tcp\":[{\"HostPort\":\"8883\"}],\"443/tcp\":[{\"HostPort\":\"8443\"}]}}}"
            },
            "env": {
              "OptimizeForPerformance": {
                "value": "false"
              }
            }
          }
        },
        "modules": {
          "vxt-orchestrator": {
            "version": "1.0",
            "type": "docker",
            "status": "running",
            "restartPolicy": "always",
            "settings": {
              "image": "ghcr.io/barakuziel-vxt/vxt-orchestrator:__TAG__",
              "createOptions": "{\"HostConfig\":{\"ExtraHosts\":[\"host.docker.internal:host-gateway\"]}}"
            },
            "env": {
              "DEVICE_CONNECTION_STRING": {
                "value": "$DEVICE_CONNECTION_STRING"
              },
              "SIGNALK_BASE_URL": {
                "value": "http://host.docker.internal:3000"
              },
              "SIGNALK_TOKEN": {
                "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6ImFkbWluIiwiaWF0IjoxNzc1NzU5MjYyfQ.UpuEAvDSuXBjTD5MfSbuzLKO_buyP2Pgp2U253VlTGo"
              },
              "INFLUXDB_URL": {
                "value": "http://host.docker.internal:8086"
              },
              "INFLUXDB_TOKEN": {
                "value": "vxt-influx-fixed-token-2026-halos"
              },
              "INFLUXDB_ORG": {
                "value": "vxt"
              },
              "INFLUXDB_BUCKET": {
                "value": "signalk_history"
              }
            }
          }
        }
      }
    },
    "$edgeHub": {
      "properties.desired": {
        "schemaVersion": "1.1",
        "routes": {
          "orchestratorToCloud": "FROM /messages/modules/vxt-orchestrator/outputs/* INTO $upstream"
        },
        "storeAndForwardConfiguration": {
          "timeToLiveSecs": 7200
        }
      }
    },
    "vxt-orchestrator": {
      "properties.desired": {}
    }
  }
}
